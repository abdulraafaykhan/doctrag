GROQ_API_KEY = ""
GEMINI_API_KEY =  ""
MONGODB_URI = "your-Atlas-connection-string"

GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_REWRITE_MODEL = "openai/gpt-oss-20b"
# Default for document-grounded answers; existing local overrides take precedence.
ANSWER_TEMPERATURE = 0.2

CORS_ORIGINS = "http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173"

ATTACHMENT_WAIT_SECONDS = 60
USER_UPLOAD_MAX_MB = 5
USER_MAX_CHUNKS_PER_DOC = 150
USER_MAX_TABLE_ROWS = 500

BANK_DB_NAME = "bank_db"
# Empty uses MONGODB_URI; runtime may use a read-only bank database user.
BANK_MONGODB_URI = ""

# History and free-tier budgets (token estimates use characters / 4).
HISTORY_MAX_MESSAGES = 12
HISTORY_TOKEN_BUDGET = 1500
OLD_ANSWER_TRIM_CHARS = 600
ROUTER_HISTORY_MESSAGES = 4
ROUTER_MESSAGE_CHARS = 300
MAX_MESSAGE_CHARS = 2000
MAX_PASSAGE_CHARS = 5000
ANSWER_MAX_TOKENS = 700
PROMPT_TOKEN_CEILING = 5000
LLM_MAX_CONCURRENCY = 2
# Per-session cap keeps a single conversation within the free-tier budget.
CHAT_RATE_PER_MINUTE = 6

# Chat activity extends session life; history fetches and browser heartbeats do not.
SESSION_IDLE_WIPE_MINUTES = 30
VERIFY_IDLE_MINUTES = 10
VERIFY_MAX_MINUTES = 30
VERIFY_MAX_TRIES = 3
VERIFY_LOCK_MINUTES = 15
# Separate IP cap stops New chat from bypassing the per-session chat limit.
CHAT_RATE_PER_IP_PER_MINUTE = 20
# Verification attempts have a separate IP window to slow credential guessing.
VERIFY_RATE_PER_IP_PER_MINUTE = 10
OTP_MODE = "demo"
OTP_VALID_MINUTES = 5
# Reserved diagnostics; account/mobile/OTP masking always remains enabled.
LOG_SHOW_SENSITIVE = false
LOG_FULL_PROMPTS = false
